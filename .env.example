# Set these on the server; do not put actual credentials in this file or GitHub.
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=fitnestprologin
# Production only, behind an HTTPS reverse proxy:
FITNEST_PUBLIC_ORIGIN=https://fitnestpro.ir
# Enable only when your loopback reverse proxy overwrites X-Real-IP:
FITNEST_TRUST_PROXY=0
# Optional private persistent storage, OUTSIDE the public web root:
# FITNEST_DATA_DIR=D:/FitNestPro-private

# Django backend: private values MUST be filled locally, never committed.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOCAL=0
DJANGO_DEBUG=0
TRUST_HTTPS_PROXY=0
TRUSTED_PROXY_CIDRS=
DB_ENGINE=postgres
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
SMS_ENABLED=0
# Payment credentials remain unconfigured; no gateway is registered.
PAYMENT_PROVIDER=
PAYMENT_MERCHANT_ID=
NESHAN_SERVICE_API_KEY=
