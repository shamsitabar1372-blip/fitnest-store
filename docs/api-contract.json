{
  "openapi": "3.1.0",
  "info": {
    "title": "FitNestPro store API",
    "version": "1.0.0",
    "description": "Same-origin Django sessions. All money is IRR. CSRF is mandatory on unsafe methods. Catalog, category, variant, coupon, shipping and image CRUD forms are provided under authenticated /admin/shop/ with Django model permissions. No API accepts client ownership, price or successful payment."
  },
  "paths": {
    "/api/auth/session": {
      "get": {
        "summary": "نشست، کوکی CSRF و وضعیت سرویس",
        "security": [],
        "responses": {
          "200": {
            "description": "درخواست موفق؛ مبالغ عدد صحیح ریالی هستند."
          },
          "400": {
            "description": "اعتبارسنجی ناموفق"
          },
          "403": {
            "description": "CSRF یا مجوز نامعتبر"
          },
          "409": {
            "description": "تغییر موجودی، وضعیت یا محدودیت سفارش"
          },
          "503": {
            "description": "سرویس تنظیم یا فعال نشده است"
          }
        }
      }
    },
